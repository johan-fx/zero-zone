{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zona-cero-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-10",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "API_VERSION": "0.0.0-boilerplate"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INCIDENT_CELL_OBJECTS",
        "class_name": "IncidentCellObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["IncidentCellObject"]
    }
  ]
}
