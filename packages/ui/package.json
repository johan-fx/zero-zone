{
  "name": "@zona-cero/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared operational design tokens and lightweight UI primitives reused by apps/mobile and apps/web-ui.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "import": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:strict": "pnpm typecheck && pnpm test",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "~19.2.2",
    "@vitejs/plugin-react": "latest",
    "@zona-cero/config": "workspace:*",
    "jsdom": "latest",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
