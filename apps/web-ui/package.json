{
  "name": "@zona-cero/web-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run src/contracts.integration.test.tsx",
    "test:strict": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@zona-cero/contracts": "workspace:*",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "~19.2.2",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
