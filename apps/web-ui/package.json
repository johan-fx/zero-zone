{
  "name": "@zona-cero/web-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run src/contracts.integration.test.tsx",
    "test:strict": "pnpm typecheck && pnpm test",
    "build:staging": "VITE_API_BASE_URL=https://zona-cero-api-staging.jauss.workers.dev VITE_INCIDENT_ID=incident-zc-demo VITE_CELL_ID=cell-zc-demo pnpm build",
    "deploy:staging": "pnpm build:staging && pnpm --filter @zona-cero/api exec wrangler pages deploy ../../apps/web-ui/dist --project-name zona-cero-web-ui-staging --branch staging"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@zona-cero/contracts": "workspace:*",
    "@zona-cero/i18n": "workspace:*",
    "@zona-cero/ui": "workspace:*",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/leaflet": "^1.9.21",
    "@types/react": "~19.2.2",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
