{
  "name": "zona-cero",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "start": "pnpm --filter @zona-cero/mobile start",
    "ios": "pnpm --filter @zona-cero/mobile ios",
    "android": "pnpm --filter @zona-cero/mobile android",
    "run:android": "pnpm --filter @zona-cero/mobile run:android",
    "run:ios": "pnpm --filter @zona-cero/mobile run:ios",
    "web": "pnpm --filter @zona-cero/mobile web",
    "mobile:start": "pnpm --filter @zona-cero/mobile start",
    "mobile:ios": "pnpm --filter @zona-cero/mobile ios",
    "mobile:android": "pnpm --filter @zona-cero/mobile android",
    "mobile:web": "pnpm --filter @zona-cero/mobile web",
    "mobile:typecheck": "pnpm --filter @zona-cero/mobile typecheck",
    "mobile:test": "pnpm --filter @zona-cero/mobile test:ci",
    "mobile:test:strict": "pnpm --filter @zona-cero/mobile test:strict",
    "typecheck": "pnpm --filter @zona-cero/mobile typecheck",
    "test": "pnpm --filter @zona-cero/mobile test",
    "test:tdd": "pnpm --filter @zona-cero/mobile test:tdd",
    "test:watch": "pnpm --filter @zona-cero/mobile test:watch",
    "test:ci": "pnpm --filter @zona-cero/mobile test:ci",
    "test:strict": "pnpm mobile:test:strict && pnpm test:workspaces && pnpm test:integration",
    "maestro:smoke:ios": "maestro test .maestro/ios-smoke.yaml",
    "maestro:offline-spike:ios": "maestro test .maestro/ios-smoke.yaml",
    "visual:audit:check": "maestro test .maestro/ios-visual-audit.yaml",
    "ios:agent": "pnpm --filter @zona-cero/mobile ios:agent",
    "visual:audit:capture": "python3 scripts/capture_visual_regression.py",
    "visual:audit:contact-sheet": "python3 scripts/build_visual_contact_sheets.py",
    "api:dev": "pnpm --filter @zona-cero/api dev",
    "api:test": "pnpm --filter @zona-cero/api test",
    "api:test:strict": "pnpm --filter @zona-cero/api test:strict",
    "web:dev": "pnpm --filter @zona-cero/web-ui dev",
    "web:build": "pnpm --filter @zona-cero/web-ui build",
    "web:test": "pnpm --filter @zona-cero/web-ui test",
    "web:test:strict": "pnpm --filter @zona-cero/web-ui test:strict",
    "telegram:test": "pnpm --filter @zona-cero/telegram-channel test",
    "telegram:test:strict": "pnpm --filter @zona-cero/telegram-channel test:strict",
    "contracts:test": "pnpm --filter @zona-cero/contracts test",
    "contracts:test:strict": "pnpm --filter @zona-cero/contracts test:strict",
    "test:packages": "pnpm --filter './packages/*' test:strict",
    "test:workspaces": "pnpm --filter @zona-cero/api test:strict && pnpm --filter @zona-cero/web-ui test:strict && pnpm --filter @zona-cero/telegram-channel test:strict && pnpm test:packages",
    "test:integration": "pnpm --filter @zona-cero/api test:integration && pnpm --filter @zona-cero/web-ui test:integration && pnpm --filter @zona-cero/telegram-channel test:integration",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@zona-cero/testing": "workspace:*"
  }
}
