{
  "name": "zona-cero",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:tdd": "jest --watch --onlyChanged",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand",
    "test:strict": "pnpm typecheck && pnpm test:ci",
    "maestro:smoke:ios": "maestro test .maestro/ios-smoke.yaml",
    "visual:audit:check": "maestro test .maestro/ios-visual-audit.yaml",
    "ios:agent": "EXPO_UNSTABLE_HEADLESS=1 expo start --ios",
    "visual:audit:capture": "python3 scripts/capture_visual_regression.py",
    "visual:audit:contact-sheet": "python3 scripts/build_visual_contact_sheets.py"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@tamagui/animations-react-native": "2.3.3",
    "@tamagui/config": "2.3.3",
    "@tamagui/core": "2.3.3",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "rxdb": "^17.3.0",
    "tamagui": "2.3.3"
  },
  "devDependencies": {
    "@tamagui/babel-plugin": "2.3.3",
    "@tamagui/metro-plugin": "2.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
